# -*- mode: sh -*-
# use hyprcursor
export HYPRCURSOR_THEME=Nordzy-hyprcursors
export HYPRCURSOR_SIZE=24

# because have force_zero_scaling = true
# for steam
# will not affect non-xwayland GTK applications
export GDK_SCALE=2

# https://wiki.hyprland.org/Configuring/Multi-GPU/
# use integrated graphics as primary renderer
# integrated as primary; external monitor will lag for my current igpu and will
# get messed up after e.g. switching ttys but a forcerenderreload will fix
# unlike if internal screen is messed up
# export AQ_DRM_DEVICES="/dev/dri/card1:/dev/dri/card0"
# nvidia first; no performance issues, but wayland wezterm breaks and laptop
# screen freezes/doesn't work after resume from hibernate
export AQ_DRM_DEVICES="/dev/dri/card0:/dev/dri/card1"

