# -*- mode: sh -*-
# use hyprcursor
export HYPRCURSOR_THEME=Nordzy-hyprcursors
export HYPRCURSOR_SIZE=24

# because have force_zero_scaling = true
# for steam
# will not affect non-xwayland GTK applications
export GDK_SCALE=2

# https://wiki.hyprland.org/Configuring/Multi-GPU/
# use integrated graphics as primary renderer
# export AQ_DRM_DEVICES="/dev/dri/intel-gpu-card:/dev/dri/nvidia-gpu-card"
# performance is still better on monitor with nvidia card first
export AQ_DRM_DEVICES="/dev/dri/nvidia-gpu-card:/dev/dri/intel-gpu-card"
